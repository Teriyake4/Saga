{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base", "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "SAGA_BUILD_TESTS": "ON", "SAGA_ENABLE_CUDA": "OFF" }
    },
    { "name": "host-debug", "inherits": "base", "generator": "Unix Makefiles", "condition": { "type": "inList", "string": "${hostSystemName}", "list": ["Darwin", "Linux"] }, "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "host-release", "inherits": "host-debug", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "host-sanitized", "inherits": "host-debug", "cacheVariables": { "SAGA_SANITIZERS": "ON" } },
    { "name": "host-thread-sanitized", "inherits": "host-debug", "cacheVariables": { "SAGA_THREAD_SANITIZER": "ON" } },
    { "name": "host-ninja-debug", "inherits": "base", "generator": "Ninja", "condition": { "type": "inList", "string": "${hostSystemName}", "list": ["Darwin", "Linux"] }, "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "host-ninja-release", "inherits": "host-ninja-debug", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "product-ninja-release", "inherits": "host-ninja-release", "cacheVariables": { "SAGA_BUILD_TESTS": "OFF", "SAGA_ENABLE_CUDA": "OFF", "SAGA_ENABLE_IMAGE_DECODER": "OFF" } },
    { "name": "windows-ninja-debug", "inherits": "base", "generator": "Ninja", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }, "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_CXX_COMPILER": "cl.exe", "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL" } },
    { "name": "windows-ninja-release", "inherits": "windows-ninja-debug", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "windows-product-ninja-release", "inherits": "windows-ninja-release", "cacheVariables": { "SAGA_BUILD_TESTS": "OFF", "SAGA_ENABLE_CUDA": "OFF", "SAGA_ENABLE_IMAGE_DECODER": "OFF" } },
    {
      "name": "windows-msvc-debug", "inherits": "base",
      "generator": "Visual Studio 17 2022", "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_CONFIGURATION_TYPES": "Debug;Release", "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL" }
    },
    {
      "name": "windows-msvc-release", "inherits": "windows-msvc-debug",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    { "name": "cuda-linux", "inherits": "base", "generator": "Ninja", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }, "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SAGA_ENABLE_CUDA": "ON", "CMAKE_CUDA_ARCHITECTURES": "89" } },
    { "name": "cuda-windows", "inherits": "base", "generator": "Ninja", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }, "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_CXX_COMPILER": "cl.exe", "SAGA_ENABLE_CUDA": "ON", "CMAKE_CUDA_ARCHITECTURES": "89", "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL" } },
    { "name": "linux-gcc-debug", "inherits": "base", "generator": "Ninja", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }, "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_CXX_COMPILER": "g++" } },
    { "name": "linux-gcc-release", "inherits": "linux-gcc-debug", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "linux-clang-debug", "inherits": "base", "generator": "Ninja", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }, "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_CXX_COMPILER": "clang++" } },
    { "name": "linux-clang-release", "inherits": "linux-clang-debug", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "linux-clang-sanitized", "inherits": "linux-clang-debug", "cacheVariables": { "SAGA_SANITIZERS": "ON" } },
    { "name": "linux-clang-thread-sanitized", "inherits": "linux-clang-debug", "cacheVariables": { "SAGA_THREAD_SANITIZER": "ON" } },
    { "name": "linux-product-release", "inherits": "linux-gcc-release", "cacheVariables": { "SAGA_BUILD_TESTS": "OFF", "SAGA_ENABLE_CUDA": "OFF", "SAGA_ENABLE_IMAGE_DECODER": "OFF" } }
  ],
  "buildPresets": [
    { "name": "host-debug", "configurePreset": "host-debug", "condition": { "type": "inList", "string": "${hostSystemName}", "list": ["Darwin", "Linux"] } },
    { "name": "host-release", "configurePreset": "host-release", "condition": { "type": "inList", "string": "${hostSystemName}", "list": ["Darwin", "Linux"] } },
    { "name": "host-sanitized", "configurePreset": "host-sanitized", "condition": { "type": "inList", "string": "${hostSystemName}", "list": ["Darwin", "Linux"] } },
    { "name": "host-thread-sanitized", "configurePreset": "host-thread-sanitized", "condition": { "type": "inList", "string": "${hostSystemName}", "list": ["Darwin", "Linux"] } },
    { "name": "host-ninja-debug", "configurePreset": "host-ninja-debug", "condition": { "type": "inList", "string": "${hostSystemName}", "list": ["Darwin", "Linux"] } },
    { "name": "host-ninja-release", "configurePreset": "host-ninja-release", "condition": { "type": "inList", "string": "${hostSystemName}", "list": ["Darwin", "Linux"] } },
    { "name": "product-ninja-release", "configurePreset": "product-ninja-release", "condition": { "type": "inList", "string": "${hostSystemName}", "list": ["Darwin", "Linux"] } },
    { "name": "windows-ninja-debug", "configurePreset": "windows-ninja-debug", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" } },
    { "name": "windows-ninja-release", "configurePreset": "windows-ninja-release", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" } },
    { "name": "windows-product-ninja-release", "configurePreset": "windows-product-ninja-release", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" } },
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug", "configuration": "Debug", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" } },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release", "configuration": "Release", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" } },
    { "name": "cuda-linux", "configurePreset": "cuda-linux", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" } },
    { "name": "cuda-windows", "configurePreset": "cuda-windows", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" } },
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" } },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" } },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" } },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" } },
    { "name": "linux-clang-sanitized", "configurePreset": "linux-clang-sanitized", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" } },
    { "name": "linux-clang-thread-sanitized", "configurePreset": "linux-clang-thread-sanitized", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" } },
    { "name": "linux-product-release", "configurePreset": "linux-product-release", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" } }
  ],
  "testPresets": [
    { "name": "host-debug", "configurePreset": "host-debug", "condition": { "type": "inList", "string": "${hostSystemName}", "list": ["Darwin", "Linux"] }, "output": { "outputOnFailure": true } },
    { "name": "host-release", "configurePreset": "host-release", "condition": { "type": "inList", "string": "${hostSystemName}", "list": ["Darwin", "Linux"] }, "output": { "outputOnFailure": true } },
    { "name": "host-sanitized", "configurePreset": "host-sanitized", "condition": { "type": "inList", "string": "${hostSystemName}", "list": ["Darwin", "Linux"] }, "output": { "outputOnFailure": true } },
    { "name": "host-thread-sanitized", "configurePreset": "host-thread-sanitized", "condition": { "type": "inList", "string": "${hostSystemName}", "list": ["Darwin", "Linux"] }, "output": { "outputOnFailure": true } },
    { "name": "host-ninja-debug", "configurePreset": "host-ninja-debug", "condition": { "type": "inList", "string": "${hostSystemName}", "list": ["Darwin", "Linux"] }, "output": { "outputOnFailure": true } },
    { "name": "host-ninja-release", "configurePreset": "host-ninja-release", "condition": { "type": "inList", "string": "${hostSystemName}", "list": ["Darwin", "Linux"] }, "output": { "outputOnFailure": true } },
    { "name": "windows-ninja-debug", "configurePreset": "windows-ninja-debug", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }, "output": { "outputOnFailure": true } },
    { "name": "windows-ninja-release", "configurePreset": "windows-ninja-release", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }, "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug", "configuration": "Debug", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }, "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release", "configuration": "Release", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }, "output": { "outputOnFailure": true } },
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }, "output": { "outputOnFailure": true } },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }, "output": { "outputOnFailure": true } },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }, "output": { "outputOnFailure": true } },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }, "output": { "outputOnFailure": true } },
    { "name": "linux-clang-sanitized", "configurePreset": "linux-clang-sanitized", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }, "output": { "outputOnFailure": true } },
    { "name": "linux-clang-thread-sanitized", "configurePreset": "linux-clang-thread-sanitized", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }, "output": { "outputOnFailure": true } }
  ]
}
