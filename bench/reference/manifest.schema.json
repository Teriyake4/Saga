{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "manifest.schema.json"
    },
    "acceptance_contract": {
      "const": {
        "comparison_classes": [
          "equal-configuration",
          "quality-matched-system",
          "best-system"
        ],
        "minimum_measured_repetitions": 5,
        "missing_unmatched_or_failed_mandatory_case_blocks": true,
        "per_case_max_uncached_ttft_ratio": 1.1,
        "per_case_min_decode_ratio": 0.95,
        "source": "IMPLEMENTATION_PLAN.md section 2"
      }
    },
    "additional_candidate_workloads": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "compatibility": {
            "enum": [
              "unverified",
              "verified"
            ]
          },
          "component": {
            "type": "string"
          },
          "files": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "bytes": {
                  "minimum": 0,
                  "type": "integer"
                },
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "sha256",
                "bytes"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "revision": {
            "pattern": "^[0-9a-f]{40}$",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "metadata-only",
              "unresolved",
              "verified"
            ]
          },
          "unresolved": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "repository",
          "revision",
          "required",
          "component",
          "status",
          "files",
          "compatibility",
          "unresolved"
        ],
        "type": "object"
      },
      "minItems": 7,
      "type": "array"
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "candidate_cases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "configuration": {
            "type": [
              "object",
              "null"
            ]
          },
          "frozen": {
            "type": "boolean"
          },
          "id": {
            "pattern": "^[a-z0-9-]+$",
            "type": "string"
          },
          "mandatory": {
            "type": "boolean"
          },
          "mode": {
            "enum": [
              "plain",
              "native-mtp"
            ]
          },
          "proposed_output_tokens": {
            "minimum": 0,
            "type": "integer"
          },
          "proposed_prompt_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "results": {
            "type": [
              "object",
              "null"
            ]
          },
          "status": {
            "enum": [
              "candidate",
              "frozen"
            ]
          },
          "unresolved": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "mode",
          "status",
          "frozen",
          "mandatory",
          "proposed_prompt_tokens",
          "proposed_output_tokens",
          "configuration",
          "unresolved",
          "results"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "format_version": {
      "const": 1
    },
    "freeze_required_fields": {
      "const": [
        "hardware_record",
        "os_driver_power",
        "engine_build_ids",
        "build_and_run_commands",
        "patches_and_sha256",
        "represented_text_weights",
        "represented_mtp_weights",
        "tokenizer_files",
        "template_files",
        "prompt_token_ids",
        "prompt_rendering",
        "generation_and_stop_rules",
        "sampling_processors_defaults_order",
        "rng_and_seeds",
        "kv_contracts_main_and_mtp",
        "actual_phase_site_dispatch",
        "accumulation_intermediate_rounding",
        "graph_modes_profiles",
        "prefill_verification_chunk_sizes",
        "prefix_reuse",
        "empty_request_state",
        "ngram",
        "draft_count_actual_verify_widths",
        "draft_head_vocabulary_support",
        "timing_boundaries",
        "warmup_repetition_noise_policy",
        "raw_record_schema"
      ]
    },
    "hardware": {
      "additionalProperties": false,
      "properties": {
        "available_vram_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "compiler": {
          "type": [
            "string",
            "null"
          ]
        },
        "cpu": {
          "type": [
            "string",
            "null"
          ]
        },
        "cuda_toolkit": {
          "type": [
            "string",
            "null"
          ]
        },
        "driver": {
          "type": [
            "string",
            "null"
          ]
        },
        "gpu_sku": {
          "type": [
            "string",
            "null"
          ]
        },
        "linux_native_evidence": {
          "type": [
            "object",
            "null"
          ]
        },
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "power_display_clocks_thermals": {
          "type": [
            "string",
            "null"
          ]
        },
        "ram_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "enum": [
            "unresolved",
            "measured-native-4080"
          ]
        },
        "windows_native_msvc_evidence": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "gpu_sku",
        "available_vram_bytes",
        "cpu",
        "ram_bytes",
        "os",
        "driver",
        "cuda_toolkit",
        "compiler",
        "power_display_clocks_thermals",
        "linux_native_evidence",
        "windows_native_msvc_evidence"
      ],
      "type": "object"
    },
    "mandatory_cases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "configuration": {
            "type": [
              "object",
              "null"
            ]
          },
          "frozen": {
            "type": "boolean"
          },
          "id": {
            "pattern": "^[a-z0-9-]+$",
            "type": "string"
          },
          "mandatory": {
            "type": "boolean"
          },
          "mode": {
            "enum": [
              "plain",
              "native-mtp"
            ]
          },
          "proposed_output_tokens": {
            "minimum": 0,
            "type": "integer"
          },
          "proposed_prompt_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "results": {
            "type": [
              "object",
              "null"
            ]
          },
          "status": {
            "enum": [
              "candidate",
              "frozen"
            ]
          },
          "unresolved": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "mode",
          "status",
          "frozen",
          "mandatory",
          "proposed_prompt_tokens",
          "proposed_output_tokens",
          "configuration",
          "unresolved",
          "results"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "model_metadata": {
      "const": "model-metadata.json"
    },
    "qualification": {
      "const": "not-qualified"
    },
    "reference_build": {
      "additionalProperties": false,
      "properties": {
        "binary_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "build_commands": {
          "type": [
            "array",
            "null"
          ]
        },
        "patches": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "repository": {
          "const": "yalding/ninfer-4080"
        },
        "revision": {
          "const": "2469b5752672ad597055af61fe28e8e7ced20056"
        },
        "run_commands": {
          "type": [
            "array",
            "null"
          ]
        },
        "runtime_dispatch_trace": {
          "type": [
            "object",
            "null"
          ]
        },
        "status": {
          "enum": [
            "not-built",
            "built-not-measured",
            "measured"
          ]
        }
      },
      "required": [
        "repository",
        "revision",
        "status",
        "patches",
        "build_commands",
        "run_commands",
        "binary_sha256",
        "runtime_dispatch_trace"
      ],
      "type": "object"
    },
    "retrieval_evidence": {
      "const": "retrieval-evidence.json"
    },
    "source_lock": {
      "const": "source-lock.json"
    },
    "status": {
      "enum": [
        "blocked",
        "ready-for-review"
      ]
    },
    "suite": {
      "additionalProperties": false,
      "properties": {
        "freeze_record": {
          "type": [
            "object",
            "null"
          ]
        },
        "mandatory_suite_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "os_scope": {
          "enum": [
            "unresolved",
            "linux-only",
            "linux-and-native-windows"
          ]
        },
        "status": {
          "enum": [
            "unfrozen",
            "frozen"
          ]
        }
      },
      "required": [
        "status",
        "freeze_record",
        "os_scope",
        "mandatory_suite_digest"
      ],
      "type": "object"
    }
  },
  "required": [
    "$schema",
    "format_version",
    "status",
    "qualification",
    "source_lock",
    "retrieval_evidence",
    "model_metadata",
    "suite",
    "hardware",
    "reference_build",
    "artifacts",
    "freeze_required_fields",
    "mandatory_cases",
    "candidate_cases",
    "additional_candidate_workloads",
    "acceptance_contract",
    "blockers"
  ],
  "type": "object"
}
