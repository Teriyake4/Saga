diff --git a/src/ops/linear/q3/q3_dispatch_audit.h b/src/ops/linear/q3/q3_dispatch_audit.h
new file mode 100644
index 0000000..d0b86a1
--- /dev/null
+++ b/src/ops/linear/q3/q3_dispatch_audit.h
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: Apache-2.0
+// Optional Saga audit instrumentation for the Apache-2.0 NInfer-4080 source.
+// Copyright (c) 2026 Saga contributors.
+#pragma once
+
+#include <cuda_runtime.h>
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
+namespace ninfer::ops::detail {
+
+inline void q3_dispatch_audit(const char* site, const char* dispatch, const char* route,
+                             const char* kernel, std::int32_t m, std::int32_t n,
+                             std::int32_t k, cudaStream_t stream) {
+    static const bool enabled = [] {
+        const char* value = std::getenv("NINFER_M0_Q3_DISPATCH_TRACE");
+        return value != nullptr && value[0] == '1' && value[1] == '\0';
+    }();
+    if (!enabled) { return; }
+
+    static std::atomic<std::uint64_t> next_record{1};
+    const std::uint64_t record_id = next_record.fetch_add(1, std::memory_order_relaxed);
+    cudaStreamCaptureStatus capture_status = cudaStreamCaptureStatusNone;
+    const cudaError_t query = cudaStreamIsCapturing(stream, &capture_status);
+    const char* event = "launch-selection";
+    const char* capture = "none";
+    if (query != cudaSuccess) {
+        event = "capture-query-error";
+        capture = "query-error";
+    } else if (capture_status == cudaStreamCaptureStatusActive) {
+        event = "graph-record-selection";
+        capture = "active";
+    } else if (capture_status == cudaStreamCaptureStatusInvalidated) {
+        event = "capture-invalidated-selection";
+        capture = "invalidated";
+    }
+
+    std::fprintf(stderr,
+                 "M0DISPATCH {\"schema\":1,\"record_id\":%llu,\"site\":\"%s\","
+                 "\"phase\":\"unknown\",\"dispatch\":\"%s\",\"route\":\"%s\","
+                 "\"kernel\":\"%s\",\"m\":%d,\"n\":%d,\"k\":%d,"
+                 "\"selected\":true,\"event\":\"%s\",\"capture_state\":\"%s\"}\n",
+                 static_cast<unsigned long long>(record_id), site, dispatch, route, kernel, m, n, k,
+                 event, capture);
+    std::fflush(stderr);
+}
+
+} // namespace ninfer::ops::detail
