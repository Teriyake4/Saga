             launch_q3_mma_small_t_a8_r32_c16(act, w, out, stream);
         }
         return;
     }
     const Q3Launch launch =
         select_q3_launch(w.n, w.k, static_cast<std::int32_t>(w.padded_shape[1]), x.ne[1], policy);
+    const char* kernel = "unknown_q3_a16_kernel";
