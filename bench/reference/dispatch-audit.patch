+    else if (launch == launch_q3_mma_small_t_r32_c8) { kernel = "launch_q3_mma_small_t_r32_c8"; }
+    else if (launch == launch_q3_mma_small_t_r32_c16) { kernel = "launch_q3_mma_small_t_r32_c16"; }
+    else if (launch == launch_q3_mma_r32_c64) { kernel = "launch_q3_mma_r32_c64"; }
+    else if (launch == launch_q3_mma_tall_r128_c64) { kernel = "launch_q3_mma_tall_r128_c64"; }
+    else if (launch == launch_q3_mma_tall_r128_c128) { kernel = "launch_q3_mma_tall_r128_c128"; }
+    q3_dispatch_audit("q3_linear_projection_dispatch", "A16", kernel, kernel, x.ne[1], w.n, w.k,
+                      stream);
     launch(x, w, out, stream);
 }
 
